DISCORD_TOKEN=your-bot-token-here
COMMAND_PREFIX=!

GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=paste-the-long-id-from-your-sheet-url-here

SUBMISSIONS_TAB=Submissions
STATUS_TAB=Status

# Right-click a channel in Discord (Developer Mode on) -> Copy Channel ID
UPDATES_CHANNEL_ID=123456789012345678

POLL_INTERVAL_SECONDS=300

# Discord role names allowed to run "!psa update" (comma-separated)
ADMIN_ROLE_NAMES=PSA Staff,Admin

# Optional: your Discord server ID, for instant slash command sync while testing.
# Right-click your server icon (Developer Mode on) -> Copy Server ID.
# Leave blank for global sync (works everywhere, but can take up to an hour to appear).
TEST_GUILD_ID=

STATE_FILE=data/last_status.json
